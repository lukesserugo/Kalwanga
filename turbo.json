{
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "build/**", ".next/**"] },
    "start": { "dependsOn": ["build"], "cache": false },
    "test": { "dependsOn": ["build"], "cache": false },
    "lint": { "cache": false },
    "clean": { "cache": false },
    "db:generate": { "cache": false },
    "db:push": { "cache": false },
    "db:seed": { "dependsOn": ["db:generate"], "cache": false }
  },
  "globalDependencies": ["pnpm-lock.yaml", "tsconfig.json"]
}
