{
  "name": "@pos/desktop",
  "version": "1.0.0",
  "description": "POS Desktop Application",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "cross-env ELECTRON_CRASHPAD_DISABLED=1 electron .",
    "dev": "cross-env ELECTRON_CRASHPAD_DISABLED=1 npm run build && cross-env ELECTRON_CRASHPAD_DISABLED=1 electron .",
    "watch": "tsup main/index.ts preload/index.ts --format cjs --watch --out-dir dist --external electron",
    "build": "tsup main/index.ts preload/index.ts --format cjs --out-dir dist --external electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "clean": "rimraf dist release",
    "postinstall": "pnpm exec electron-rebuild -f -w serialport"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "node-addon-api": "^8.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "sql.js": "^1.14.2",
    "@pos/scanner": "workspace:*",
    "serialport": "^12.0.0",
    "@serialport/parser-readline": "^12.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/sql.js": "^1.4.11",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "rimraf": "^5.0.10",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.pos-system.desktop",
    "productName": "POS System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
