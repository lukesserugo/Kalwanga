{
  "name": "@pos/desktop",
  "version": "1.0.0",
  "description": "POS Desktop Application",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "watch": "tsup main/index.ts preload/index.ts --format cjs --watch --out-dir dist --external electron",
    "build": "tsup main/index.ts preload/index.ts --format cjs --out-dir dist --external electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "clean": "rimraf dist release"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "node-addon-api": "^8.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "rimraf": "^5.0.10",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.pos-system.desktop",
    "productName": "POS System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
