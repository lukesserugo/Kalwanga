  order          Order?         @relation(fields: [orderId], references: [id])
  sale           Sale?          @relation(fields: [saleId], references: [id])

  @@map("receipts")
}

model AuditLog {
  id             String        @id @default(cuid())
  action         AuditAction
  entityType     String
  entityId       String
  entityName     String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  severity       AuditSeverity @default(INFO)
  createdAt      DateTime      @default(now())
  userId         String
  companyId      String?
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  company        Company?      @relation(fields: [companyId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ShiftLog {
  id                    String               @id @default(cuid())
  shiftStart            DateTime             @default(now())
  shiftEnd              DateTime?
  startingCash          Float
  endingCash            Float?
  expectedCash          Float?
  discrepancy           Float?
  discrepancyReason     String?
  notes                 String?
  entityName            String?
  status                ShiftStatus          @default(OPEN)
  type                  ShiftType            @default(MORNING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userId                String
  businessUnitId        String
  cashRegisterSessionId String?              @unique
  businessUnit          BusinessUnit         @relation(fields: [businessUnitId], references: [id])
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id])

  @@map("shift_logs")
}

model Notification {
  id             String               @id @default(cuid())
  title          String
  message        String
  type           NotificationType
  priority       NotificationPriority @default(MEDIUM)
  isRead         Boolean              @default(false)
  link           String?
  createdAt      DateTime             @default(now())
  readAt         DateTime?
  data           Json?
  userId         String
  companyId      String?
  businessUnitId String?
  businessUnit   BusinessUnit?        @relation(fields: [businessUnitId], references: [id])
  company        Company?             @relation(fields: [companyId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Report {
  id          String       @id @default(cuid())
  name        String
  type        ReportType
  format      ReportFormat @default(PDF)
  data        Json
  period      String
  startDate   DateTime?
  endDate     DateTime?
  generatedAt DateTime     @default(now())
  companyId   String
  userId      String
  company     Company      @relation(fields: [companyId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@map("reports")
}

model Cart {
  id             String        @id @default(cuid())
  userId         String
  businessUnitId String
  customerId     String?
  subtotal       Float         @default(0)
  tax            Float         @default(0)
  discount       Float         @default(0)
  total          Float         @default(0)
  notes          String?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          CartItem[]
  businessUnit   BusinessUnit  @relation(fields: [businessUnitId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession?

  @@unique([userId, businessUnitId])
  @@map("carts")
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  unitPrice Float
  total     Float
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("cart_items")
}

model CartSettings {
  id                       String       @id @default(cuid())
  businessUnitId           String       @unique
  allowGuestCheckout       Boolean      @default(true)
  requireCustomerForReturn Boolean      @default(false)
  maxCartItems             Int          @default(50)
  cartExpiryHours          Int          @default(24)
  discountEnabled          Boolean      @default(true)
  maxDiscountPercentage    Float        @default(20)
  maxDiscountAmount        Float        @default(100)
  autoApplyPromotions      Boolean      @default(true)
  loyaltyPointsEnabled     Boolean      @default(true)
  pointsPerDollar          Int          @default(10)
  minPointsForRedeem       Int          @default(100)
  maxPointsPerOrder        Int          @default(1000)
  reserveStockOnAdd        Boolean      @default(true)
  reserveStockMinutes      Int          @default(15)
  lowStockThreshold        Int          @default(5)
  defaultPaymentMethod     String       @default("CASH")
  allowPartialPayment      Boolean      @default(true)
  requireSignature         Boolean      @default(false)
  taxInclusive             Boolean      @default(false)
  freeShippingThreshold    Float        @default(50)
  shippingCost             Float        @default(5)
  taxRate                  Float        @default(8)
  notifyOnAbandonedCart    Boolean      @default(true)
  abandonedCartHours       Int          @default(24)
  notifyOnLowStock         Boolean      @default(true)
  currencyCode             String       @default("USD")
  currencySymbol           String       @default("$")
  showStockBadge           Boolean      @default(true)
  showVariantImages        Boolean      @default(true)
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  businessUnit             BusinessUnit @relation(fields: [businessUnitId], references: [id])

  @@map("cart_settings")
}

model CheckoutSettings {
  id                       String       @id @default(cuid())
  businessUnitId           String       @unique
  allowGuestCheckout       Boolean      @default(true)
  requireCustomerForReturn Boolean      @default(false)
  requireSignature         Boolean      @default(false)
  allowPartialPayment      Boolean      @default(true)
  maxDiscount              Float        @default(50)
  taxInclusive             Boolean      @default(false)
  defaultPaymentMethod     String       @default("CASH")
  receiptFooter            String       @default("Thank you for your business!")
  loyaltyPointsEnabled     Boolean      @default(true)
  pointsPerDollar          Int          @default(10)
  maxCartItems             Int          @default(100)
  cartExpiryHours          Int          @default(24)
  reserveStockOnAdd        Boolean      @default(true)
  reserveStockMinutes      Int          @default(15)
  lowStockThreshold        Int          @default(5)
  discountEnabled          Boolean      @default(true)
  maxDiscountPercentage    Float        @default(20)
  autoApplyPromotions      Boolean      @default(false)
  freeShippingThreshold    Float        @default(100)
  shippingCost             Float        @default(0)
  taxRate                  Float        @default(8)
  notifyOnAbandonedCart    Boolean      @default(true)
  abandonedCartHours       Int          @default(2)
  currencyCode             String       @default("USD")
  currencySymbol           String       @default("$")
  showStockBadge           Boolean      @default(true)
  showVariantImages        Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  businessUnit             BusinessUnit @relation(fields: [businessUnitId], references: [id])

  @@map("checkout_settings")
}

model Account {
  id             String          @id @default(cuid())
  code           String
  name           String
  type           AccountType
  category       AccountCategory
  isActive       Boolean         @default(true)
  businessUnitId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  lines          JournalLine[]

  @@unique([businessUnitId, code])
  @@index([businessUnitId])
  @@map("accounts")
}

model JournalEntry {
  id             String             @id @default(cuid())
  entryNumber    String             @unique
  date           DateTime           @default(now())
  description    String
  reference      String?
  status         JournalEntryStatus @default(POSTED)
  businessUnitId String
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  businessUnit   BusinessUnit       @relation(fields: [businessUnitId], references: [id])
  creator        User               @relation(fields: [createdBy], references: [id])
  lines          JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@map("journal_lines")
}

model TaxRecord {
  id             String          @id @default(cuid())
  saleId         String
  taxType        String
  taxRate        Float
  taxAmount      Float
  taxableAmount  Float
  businessUnitId String
  period         String
  filingStatus   TaxFilingStatus @default(PENDING)
  filedAt        DateTime?
  createdAt      DateTime        @default(now())
