generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                 @id @default(cuid())
  clerkId                String                 @unique
  email                  String                 @unique
  password               String?
  firstName              String
  lastName               String
  phoneNumber            String?
  avatar                 String?
  role                   UserRole               @default(USER)
  isActive               Boolean                @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  permissions            String[]               @default([])
  companyId              String?
  stripeCustomerId       String?                @unique
  stripePaymentMethodId  String?
  activityLogs           ActivityLog[]
  auditLogs              AuditLog[]
  barcodeImages          BarcodeImageRecord[]
  bills                  Bill[]
  businessUnits          BusinessUnitUser[]
  carts                  Cart[]
  cashRegisterSessions   CashRegisterSession[]
  cashTransactions       CashTransaction[]
  expenses               Expense[]
  exportHistory          ExportHistory[]
  financialReports       FinancialReport[]
  giftCardTransactions   GiftCardTransaction[]
  importHistory          ImportHistory[]
  inventoryIssues        InventoryIssue[]
  inventoryTransactions  InventoryTransaction[]
  invitations            Invitation[]           @relation("InvitedByUser")
  invoices               Invoice[]
  journalEntries         JournalEntry[]
  loyaltyHistories       LoyaltyHistory[]
  notifications          Notification[]
  onboardingEvents       OnboardingEvent[]
  onboardingProgress     OnboardingProgress?
  orders                 Order[]
  payments               Payment[]
  productReviews         ProductReview[]
  createdProducts        Product[]              @relation("ProductCreator")
  updatedProducts        Product[]              @relation("ProductUpdater")
  purchaseOrdersReceived PurchaseOrder[]        @relation("POReceiver")
  purchaseOrders         PurchaseOrder[]
  qrCodes                QRCodeRecord[]
  receipts               Receipt[]              @relation("ReceiptLastPrintedBy")
  recentlyViewed         RecentlyViewed[]
  refundProcessed        Refund[]               @relation("RefundProcessedBy")
  refunds                Refund[]
  reports                Report[]
  returnProcessed        Return[]               @relation("ReturnProcessedBy")
  returns                Return[]
  sales                  Sale[]
  shiftLogs              ShiftLog[]
  groupMemberships       UserGroupMember[]
  createdGroups          UserGroup[]            @relation("GroupCreator")
  company                Company?               @relation(fields: [companyId], references: [id])
  wishlist               Wishlist[]

  @@map("users")
}

model OnboardingProgress {
  id             String    @id @default(cuid())
  userId         String    @unique
  companyId      String?
  businessUnitId String?
  steps          Json      @default("{}")
  completedAt    DateTime?
  isComplete     Boolean   @default(false)
  totalSteps     Int       @default(12)
  completedCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isComplete])
  @@map("onboarding_progress")
}

model OnboardingEvent {
  id            String   @id @default(cuid())
  userId        String
  stepId        Int
  stepKey       String
  event         String
  previousState Json?
  newState      Json?
  source        String   @default("auto")
  notes         String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, stepId])
  @@index([createdAt])
  @@map("onboarding_events")
}

model ImportHistory {
  id             String   @id @default(cuid())
  fileName       String
  fileSize       Int
  totalRows      Int
  successCount   Int      @default(0)
  failedCount    Int      @default(0)
  warningCount   Int      @default(0)
  skippedCount   Int      @default(0)
  status         String   @default("pending")
  importedBy     String
  importedById   String?
  importDuration Int      @default(0)
  errorSummary   String?
  importedAt     DateTime @default(now())
  importedByUser User?    @relation(fields: [importedById], references: [id])

  @@index([status])
  @@index([importedAt])
  @@map("import_history")
}

model Invitation {
  id              String    @id @default(cuid())
  email           String
  role            UserRole
  businessUnitId  String?
  message         String?
  expiresIn       Int       @default(7)
  status          String    @default("pending")
  sentAt          DateTime?
  expiresAt       DateTime?
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  invitationToken String    @unique
  invitedBy       String
  invitedById     String?
  reminderSent    Boolean   @default(false)
  reminderSentAt  DateTime?
  reminderCount   Int       @default(0)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invitedByUser   User?     @relation("InvitedByUser", fields: [invitedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([invitationToken])
  @@map("invitations")
}

model UserGroup {
  id            String            @id @default(cuid())
  name          String            @unique
  description   String?
  icon          String?
  color         String?
  permissions   String[]          @default([])
  isActive      Boolean           @default(true)
  createdBy     String
  createdById   String?
  parentGroupId String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  members       UserGroupMember[]
  createdByUser User?             @relation("GroupCreator", fields: [createdById], references: [id])
  parentGroup   UserGroup?        @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups   UserGroup[]       @relation("GroupHierarchy")

  @@index([name])
  @@index([isActive])
  @@map("user_groups")
}

model UserGroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     UserRole  @default(USER)
  isLead   Boolean   @default(false)
  joinedAt DateTime  @default(now())
  group    UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("user_group_members")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  description String
  timestamp   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  device      String?
  location    String?
  status      String   @default("success")
  severity    String   @default("info")
  resource    String?
  resourceId  String?
  metadata    Json?
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("activity_logs")
}

model InvitationTemplate {
  id        String    @id @default(cuid())
  name      String
  subject   String
  body      String
  role      UserRole?
  variables String[]  @default([])
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("invitation_templates")
}

model Company {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String
  address         String?
  taxId           String?
  currency        String           @default("USD")
  timezone        String           @default("UTC")
  logo            String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditLogs       AuditLog[]
  businessUnits   BusinessUnit[]
  settings        CompanySettings?
  customers       Customer[]
  giftCards       GiftCard[]
  invoices        Invoice[]
  loyaltyPrograms LoyaltyProgram[]
  notifications   Notification[]
  paymentGateways PaymentGateway[]
  promotions      Promotion[]
  receipts        Receipt[]
  refunds         Refund[]
  reports         Report[]
  returns         Return[]
  salesSettings   SalesSettings?
  suppliers       Supplier[]
  users           User[]

  @@map("companies")
}

model CompanySettings {
  id                       String   @id @default(cuid())
  companyId                String   @unique
  taxRate                  Float    @default(8)
  taxInclusive             Boolean  @default(false)
  receiptFooter            String?
  receiptHeader            String?
  lowStockThreshold        Int      @default(10)
  autoReorder              Boolean  @default(false)
  allowReturns             Boolean  @default(true)
  requireCustomerForReturn Boolean  @default(false)
  maxReturnDays            Int      @default(30)
  allowCash                Boolean  @default(true)
  allowCard                Boolean  @default(true)
  allowMobileMoney         Boolean  @default(true)
  allowGiftCards           Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  company                  Company  @relation(fields: [companyId], references: [id])

  @@map("company_settings")
}

model BusinessUnitUser {
  id             String       @id @default(cuid())
  userId         String
  businessUnitId String
  role           UserRole     @default(EMPLOYEE)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, businessUnitId])
  @@map("business_unit_users")
}

model BusinessUnit {
  id                    String                 @id @default(cuid())
  name                  String
  code                  String                 @unique
  address               String?
  phone                 String?
  email                 String?
  type                  BusinessUnitType       @default(STORE)
  isActive              Boolean                @default(true)
  settings              Json?
  taxRate               Float?
  currency              String                 @default("USD")
  timezone              String                 @default("UTC")
  logo                  String?
  description           String?
  parentId              String?
  metadata              Json?
  deletedAt             DateTime?
  deletedBy             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  companyId             String
  accounts              Account[]
  auditLogs             AuditLog[]
  barcodeImages         BarcodeImageRecord[]
  bills                 Bill[]
  users                 BusinessUnitUser[]
  company               Company                @relation(fields: [companyId], references: [id])
  parent                BusinessUnit?          @relation("BusinessUnitHierarchy", fields: [parentId], references: [id])
  children              BusinessUnit[]         @relation("BusinessUnitHierarchy")
  cartSettings          CartSettings?
  carts                 Cart[]
  cashRegisters         CashRegister[]
  categories            Category[]
  checkoutSettings      CheckoutSettings?
  expenses              Expense[]
  exportHistory         ExportHistory[]
  financialReports      FinancialReport[]
  giftCards             GiftCard[]
  inventory             Inventory[]
  inventoryIssues       InventoryIssue[]
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]
  journalEntries        JournalEntry[]
  locationSettings      LocationSettings?
  locations             Location[]
  loyaltyHistories      LoyaltyHistory[]
  notifications         Notification[]
  orders                Order[]
  paymentMethodConfigs  PaymentMethodConfig[]
  paymentProviders      PaymentProvider[]
  payments              Payment[]
  productPromotions     ProductPromotion[]
  productReviews        ProductReview[]
  products              Product[]
  purchaseOrders        PurchaseOrder[]
  qrCodes               QRCodeRecord[]
  receipts              Receipt[]
  recentlyViewed        RecentlyViewed[]
  refunds               Refund[]
  returns               Return[]
  sales                 Sale[]
  shiftLogs             ShiftLog[]
  taxCalculations       TaxCalculation[]
  taxRecords            TaxRecord[]
  wishlist              Wishlist[]

  @@index([companyId])
  @@index([parentId])
  @@index([code])
  @@index([deletedAt])
  @@map("business_units")
}

model Location {
  id             String       @id @default(cuid())
  name           String
  code           String?
  description    String?
  address        String?
  phone          String?
  type           LocationType @default(STORE)
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)
  metadata       Json?
  businessUnitId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  inventories    Inventory[]
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([businessUnitId, name])
  @@unique([businessUnitId, code])
  @@index([businessUnitId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("locations")
}

model LocationSettings {
  id                              String       @id @default(cuid())
  businessUnitId                  String       @unique
  defaultLocationId               String?
  enabledTypes                    String[]     @default([])
  allowNegativeStock              Boolean      @default(false)
  reserveStockOnAdd               Boolean      @default(true)
  defaultReorderPoint             Int          @default(5)
  defaultReorderQuantity          Int          @default(10)
  requireTransferReference        Boolean      @default(false)
  autoReceiveTransfers            Boolean      @default(false)
  allowCrossBusinessUnitTransfers Boolean      @default(false)
  showCodeOnCards                 Boolean      @default(true)
  showInactiveInLists             Boolean      @default(false)
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
  businessUnit                    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@map("location_settings")
}

model SalesSettings {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  taxRate              Float    @default(8)
  discountEnabled      Boolean  @default(true)
  maxDiscount          Float    @default(20)
  loyaltyPointsEnabled Boolean  @default(true)
  pointsPerDollar      Int      @default(10)
  autoPrintReceipt     Boolean  @default(true)
  emailReceipts        Boolean  @default(true)
  receiptFooter        String   @default("Thank you for your business!")
  defaultPaymentMethod String   @default("CASH")
  currencySymbol       String   @default("$")
  currencyCode         String   @default("USD")
  invoicePrefix        String   @default("INV-")
  receiptPrefix        String   @default("RCP-")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id])

  @@map("sales_settings")
}

model Return {
  id              String       @id @default(cuid())
  returnNumber    String       @unique
  saleId          String
  customerId      String?
  userId          String
  processedBy     String?
  reason          String
  status          ReturnStatus @default(PENDING)
  returnType      ReturnType   @default(PARTIAL)
  refundMethod    RefundMethod @default(ORIGINAL_PAYMENT)
  subtotal        Float
  tax             Float        @default(0)
  total           Float
  notes           String?
  createdAt       DateTime     @default(now())
  processedAt     DateTime?
  updatedAt       DateTime     @updatedAt
  companyId       String
  businessUnitId  String
  refund          Refund?      @relation("ReturnRefund")
  items           ReturnItem[]
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id])
  company         Company      @relation(fields: [companyId], references: [id])
  customer        Customer?    @relation(fields: [customerId], references: [id])
  processedByUser User?        @relation("ReturnProcessedBy", fields: [processedBy], references: [id])
  sale            Sale         @relation(fields: [saleId], references: [id])
  user            User         @relation(fields: [userId], references: [id])

  @@map("returns")
}

model ReturnItem {
  id        String          @id @default(cuid())
  returnId  String
  productId String
  variantId String?
  quantity  Int
  unitPrice Float
  total     Float
  reason    String?
  condition String          @default("good")
  notes     String?
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
  return    Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("return_items")
}

model Refund {
  id              String       @id @default(cuid())
  refundNumber    String       @unique
  saleId          String
  returnId        String?      @unique
  customerId      String?
  userId          String
  processedBy     String?
  reason          String
  status          RefundStatus @default(PENDING)
  refundMethod    RefundMethod @default(ORIGINAL_PAYMENT)
  refundType      String       @default("full")
  subtotal        Float
  tax             Float        @default(0)
  total           Float
  notes           String?
  paymentId       String?
  createdAt       DateTime     @default(now())
  processedAt     DateTime?
  completedAt     DateTime?
  updatedAt       DateTime     @updatedAt
  companyId       String
  businessUnitId  String
  items           RefundItem[]
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id])
  company         Company      @relation(fields: [companyId], references: [id])
  customer        Customer?    @relation(fields: [customerId], references: [id])
  payment         Payment?     @relation(fields: [paymentId], references: [id])
  processedByUser User?        @relation("RefundProcessedBy", fields: [processedBy], references: [id])
  return          Return?      @relation("ReturnRefund", fields: [returnId], references: [id])
  sale            Sale         @relation(fields: [saleId], references: [id])
  user            User         @relation(fields: [userId], references: [id])

  @@map("refunds")
}

model RefundItem {
  id        String          @id @default(cuid())
  refundId  String
  productId String
  variantId String?
  quantity  Int
  unitPrice Float
  total     Float
  reason    String?
  notes     String?
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
  refund    Refund          @relation(fields: [refundId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("refund_items")
}

model ExportHistory {
  id             String        @id @default(cuid())
  fileName       String
  format         ExportFormat  @default(CSV)
  size           Int
  status         ExportStatus  @default(PROCESSING)
  downloadUrl    String?
  errorMessage   String?
  filters        Json?
  userId         String
  businessUnitId String?
  createdAt      DateTime      @default(now())
  downloadedAt   DateTime?
  expiresAt      DateTime?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@map("export_history")
}

model Category {
  id              String       @id @default(cuid())
  name            String
  description     String?
  parentId        String?
  isActive        Boolean      @default(true)
  featured        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  businessUnitId  String
  color           String?
  icon            String?
  image           String?
  metaDescription String?
  metaTitle       String?
  slug            String
  sortOrder       Int          @default(0)
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id])
  parent          Category?    @relation("CategoryParent", fields: [parentId], references: [id])
  children        Category[]   @relation("CategoryParent")
  products        Product[]

  @@unique([businessUnitId, slug])
  @@index([businessUnitId])
  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  sku                   String                 @unique
  barcode               String?                @unique
  unitPrice             Float
  costPrice             Float?
  taxRate               Float?                 @default(0)
  minStock              Int                    @default(5)
  maxStock              Int?
  isActive              Boolean                @default(true)
  isDigital             Boolean                @default(false)
  featured              Boolean                @default(false)
  weight                Float?
  dimensions            Json?
  attributes            Json?
  notes                 String?
  rating                Float?                 @default(0)
  reviewCount           Int?                   @default(0)
  tags                  String[]               @default([])
  seo                   Json?
  status                ProductStatus          @default(ACTIVE)
  type                  ProductType            @default(SIMPLE)
  taxType               TaxType                @default(EXCLUSIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  deletedBy             String?
  categoryId            String?
  businessUnitId        String
  supplierId            String?
  inventoryId           String?                @unique
  createdBy             String?
  updatedBy             String?
  barcodeImages         BarcodeImageRecord[]
  cartItems             CartItem[]
  inventoryIssues       InventoryIssue[]
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  images                ProductImage[]
  promotions            ProductPromotion[]
  reviews               ProductReview[]
  variants              ProductVariant[]
  businessUnit          BusinessUnit           @relation(fields: [businessUnitId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id])
  creator               User?                  @relation("ProductCreator", fields: [createdBy], references: [id])
  inventory             Inventory?             @relation("ProductInventory", fields: [inventoryId], references: [id])
  supplier              Supplier?              @relation("ProductSupplier", fields: [supplierId], references: [id])
  updater               User?                  @relation("ProductUpdater", fields: [updatedBy], references: [id])
  purchaseOrderItems    PurchaseOrderItem[]
  qrCodes               QRCodeRecord[]
  recentlyViewed        RecentlyViewed[]
  refundItems           RefundItem[]
  returnItems           ReturnItem[]
  saleItems             SaleItem[]
  wishlist              Wishlist[]

  @@index([businessUnitId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([barcode])
  @@index([deletedAt])
  @@index([inventoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String   @db.VarChar(2048)
  alt       String?
  width     Int?
  height    Int?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId])
  @@index([order])
  @@map("product_images")
}

model ProductVariant {
  id                    String                 @id @default(cuid())
  productId             String
  name                  String
  sku                   String                 @unique
  price                 Float
  costPrice             Float?
  stock                 Int                    @default(0)
  attributes            Json                   @default("{}")
  isActive              Boolean                @default(true)
  barcode               String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  deletedBy             String?
  inventoryId           String?                @unique
  barcodeImages         BarcodeImageRecord[]
  cartItems             CartItem[]
  inventoryIssues       InventoryIssue[]
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  images                ProductVariantImage[]
  inventory             Inventory?             @relation("VariantInventory", fields: [inventoryId], references: [id])
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrderItems    PurchaseOrderItem[]
  qrCodes               QRCodeRecord[]
  refundItems           RefundItem[]
  returnItems           ReturnItem[]
  saleItems             SaleItem[]

  @@index([productId])
  @@index([sku])
  @@index([deletedAt])
  @@index([inventoryId])
  @@index([barcode])
  @@map("product_variants")
}

model ProductVariantImage {
  id        String         @id @default(cuid())
  variantId String
  url       String         @db.VarChar(2048)
  alt       String?
  order     Int            @default(0)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, url])
  @@index([variantId])
  @@index([order])
  @@map("product_variant_images")
}

model ProductReview {
  id             String               @id @default(cuid())
  productId      String
  userId         String
  rating         Int                  @default(5)
  title          String?
  comment        String?
  isVerified     Boolean              @default(false)
  helpfulCount   Int                  @default(0)
  status         ReviewStatus         @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  businessUnitId String?
  images         ProductReviewImage[]
  businessUnit   BusinessUnit?        @relation(fields: [businessUnitId], references: [id])
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@map("product_reviews")
}

model ProductReviewImage {
  id        String        @id @default(cuid())
  reviewId  String
  url       String        @db.VarChar(2048)
  alt       String?
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, url])
  @@index([reviewId])
  @@map("product_review_images")
}

model QRCodeRecord {
  id             String          @id @default(cuid())
  code           String          @unique
  data           String
  type           String
  imageUrl       String?
  isActive       Boolean         @default(true)
  scans          Int             @default(0)
  lastScanned    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productId      String?
  variantId      String?
  businessUnitId String?
  createdBy      String?
