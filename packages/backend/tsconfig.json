{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pos/shared/*": ["../shared/src/*"]
    },
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2020",
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist", ".prisma"]
}
