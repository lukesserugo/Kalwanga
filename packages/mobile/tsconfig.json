{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@pos/shared": ["../shared/src/index.ts"],
      "@pos/shared/*": ["../shared/src/*"],
      "@pos/tokens": ["../tokens/src/index.ts"],
      "@pos/tokens/*": ["../tokens/src/*"]
    },
    "jsx": "react-native",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["node", "web-bluetooth"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "web-build", ".expo"]
}